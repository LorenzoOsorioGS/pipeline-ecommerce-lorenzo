# Copie para .env:  cp .env.example .env   (Windows: copy .env.example .env)

# MongoDB do docker-compose (porta publicada só em 127.0.0.1)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ecommerce

# Tamanho do lote na carga (bulk_write). 100 → 5 lotes para os 500 pedidos.
BATCH_SIZE=100

# Chave secreta do HMAC que pseudonimiza o nome do cliente (T10 / decisão D5).
# Troque por um valor longo e aleatório. Trocar a chave muda todos os cliente_ref.
HMAC_KEY=troque-esta-chave-por-uma-frase-longa-e-aleatoria

# Extração: "auto" tenta o kagglehub e cai para data/raw/ se falhar; "local" usa só data/raw/.
EXTRACT_MODE=auto

# Login do mongo-express (http://localhost:8081)
ME_USER=admin
ME_PASSWORD=admin123

# Nível de log: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
